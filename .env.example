# Copy this file to .env and fill in your values.

# ---- LLM provider: openai | anthropic | gemini ----
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Business ----
BUSINESS_NAME=Nexus CCTV & Security Ltd
SALES_NOTIFY_EMAIL=sales@example.com

# ---- Database (defaults to a local SQLite file, zero setup) ----
# For Postgres, e.g.: postgresql+psycopg2://user:pass@localhost:5432/inbox_agent
DATABASE_URL=sqlite:///./inbox_agent.db

# ---- WhatsApp Cloud API (optional - only needed for the real webhook) ----
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
